# Settings for this computer, read by ./nomad (start.sh, llm-bridge.sh, link.ps1). Copy to network/local.env.
# Chat model, downloaded once by ./nomad start when missing (default qwen3:8b; bigger = smarter but slower)
# CHAT_MODEL=qwen3:8b
# macOS / Linux only:
# Command that starts your own Ollama when it is not running (default: the Ollama app or service)
# OLLAMA_START=$HOME/my-ollama/start.sh
# Caddy binary for the bridge (default: caddy on PATH, installed by ./nomad start)
# CADDY=/opt/homebrew/bin/caddy
