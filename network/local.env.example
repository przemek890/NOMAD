# Settings for this computer, read by start.sh and llm-bridge.sh. Copy to network/local.env.
# Command that starts Ollama when it is not running (empty: start it yourself)
# OLLAMA_START="open -a Ollama"
# Caddy binary for the bridge (default: caddy on PATH)
# CADDY=/opt/homebrew/bin/caddy
# Ollama address on this computer
# OLLAMA_URL=127.0.0.1:11434
