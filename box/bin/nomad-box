#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/nomad-box/common.sh

start_engine() {
  log "Starting the inner Docker Engine"
  dockerd-entrypoint.sh dockerd --host=unix:///var/run/docker.sock >/var/log/dockerd.log 2>&1 &
  ENGINE_PID=$!
  trap stop_all TERM INT
  wait_for 120 docker info || fail "Docker Engine did not start. Is the container running with --privileged? See /var/log/dockerd.log"
}

stop_all() {
  log "Stopping NOMAD"
  stack stop --timeout 30 || true
  kill -TERM "$ENGINE_PID" 2>/dev/null || true
  wait "$ENGINE_PID" || true
  exit 0
}

load_images() {
  local archive ref id
  shopt -s nullglob
  local archives=("$IMAGES_DIR"/*.tar)
  ((${#archives[@]})) || fail "No images in ${IMAGES_DIR}. Run: make build"
  for archive in "${archives[@]}"; do
    read -r ref id < <(tar -xOf "$archive" manifest.json \
      | jq -r '.[0] | "\(.RepoTags[0] // "-") sha256:\(.Config | sub(".*/"; "") | rtrimstr(".json"))"')
    [[ $(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null) == "$id" ]] && continue
    log "Loading image ${ref}"
    docker load --quiet --input "$archive"
  done
}

ensure_secrets() {
  mkdir -p "${NOMAD_HOME}"/{storage/logs,storage/kb_uploads,mysql,redis}
  [[ -s $SECRETS_FILE ]] && return
  if [[ -n $(ls -A "${NOMAD_HOME}/mysql") ]]; then
    fail "${SECRETS_FILE} is missing but the mysql directory has data. Restore the secrets file or delete ${NOMAD_HOME}/mysql."
  fi
  log "Generating secrets in ${SECRETS_FILE}"
  (
    umask 077
    cat >"$SECRETS_FILE" <<EOF
NOMAD_APP_KEY=$(openssl rand -hex 32)
NOMAD_DB_PASSWORD=$(openssl rand -hex 16)
NOMAD_DB_ROOT_PASSWORD=$(openssl rand -hex 16)
EOF
  )
}

main() {
  start_engine
  load_images
  ensure_secrets
  nomad-llm serve &
  nomad-domain caddyfile
  log "Starting Project NOMAD ${NOMAD_VERSION}"
  stack up --detach --remove-orphans
  docker image prune --force >/dev/null
  if wait_for 600 curl -fsS "${API_URL}/health"; then
    nomad-domain links || log "Could not set the HTTPS app links"
    log "Command Center ready: ${NOMAD_URL}"
    nomad-preload &
  else
    log "Command Center is not responding yet. Check: make logs-admin"
  fi
  wait "$ENGINE_PID"
}

main "$@"
