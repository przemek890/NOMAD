#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/nomad-box/common.sh
source "$SECRETS_FILE"

readonly SOURCES=/opt/nomad-box/content/sources.txt
readonly KNOWLEDGE_DIR=/opt/nomad-box/content/knowledge
readonly ZIM_DIR="${NOMAD_HOME}/storage/zim"
readonly MAPS_DIR="${NOMAD_HOME}/storage/maps"
readonly KB_DIR="${NOMAD_HOME}/storage/kb_uploads"
# The same directories as seen from nomad_admin (source paths in the AI knowledge base)
readonly ADMIN_ZIM_DIR=/app/storage/zim
readonly ADMIN_KB_DIR=/app/storage/kb_uploads
readonly EMBED_LOCK=/run/nomad-embed.lock

items() {
  awk -v kind="$1" '$1 == kind { print $2 }' "$SOURCES"
}

exists() {
  compgen -G "$1" >/dev/null
}

service_status() {
  db_query "SELECT CONCAT(installed, ':', installation_status) FROM services WHERE service_name = '$1'"
}

await_service() {
  local name=$1 status
  local deadline=$((SECONDS + 1800))
  while ((SECONDS < deadline)); do
    status=$(service_status "$name" 2>/dev/null) || status=unknown
    [[ $status == 1:* ]] && return
    [[ $status == *:error ]] && fail "Installing ${name} failed. Details: make logs-admin"
    sleep 5
  done
  fail "${name} did not install within 30 min. Details: make logs-admin"
}

add_service() {
  local name=$1 status
  status=$(service_status "$name")
  [[ -n $status ]] || fail "Unknown service ${name}"
  [[ $status == 1:* ]] && return
  log "Installing ${name}"
  [[ $status == *:installing ]] || api POST /system/services/install --data "$(json --arg n "$name" '{service_name: $n}')" >/dev/null \
    || fail "Could not start installing ${name}"
  await_service "$name"
  log "✓ ${name}"
}

add_zim() {
  local url=$1 name=${1##*/}
  # Only finished files count: a .zim.tmp left by a stalled download must not block a new one
  if [[ $url == *.zim ]]; then
    exists "${ZIM_DIR}/${name}" && return
  else
    exists "${ZIM_DIR}/${name}_[0-9][0-9][0-9][0-9]-[0-9][0-9].zim" && return
    name=$(curl -fsSL "${url%/*}/" | grep -oE "${name}_[0-9]{4}-[0-9]{2}\.zim" | sort | tail -n1)
    [[ -n $name ]] || fail "No ZIM file found for ${url}"
    url="${url%/*}/${name}"
  fi
  log "Downloading ZIM in the background: ${name}"
  api POST /zim/download-remote --data "$(json --arg u "$url" '{url: $u}')" >/dev/null
}

add_map() {
  local code=${1^^}
  exists "${MAPS_DIR}/pmtiles/${code,,}_*.pmtiles*" && return
  [[ -d ${MAPS_DIR}/basemaps-assets ]] || api POST /maps/download-base-assets --data '{}' >/dev/null
  log "Downloading map in the background: ${code}"
  api POST /maps/extract --data "$(json --arg c "$code" '{countries: [$c]}')" >/dev/null
}

add_category() {
  local count
  count=$(api POST /zim/download-category-tier \
    --data "$(json --arg c "${1%-*}" --arg t "$1" '{categorySlug: $c, tierSlug: $t}')" | jq '.resources | length') \
    || fail "Could not download collection ${1}"
  [[ $count == 0 ]] || log "Downloading collection ${1} in the background (${count} files)"
}

sync_knowledge() {
  local file target
  while IFS= read -r -d '' file; do
    target="${KB_DIR}/${file#"$KNOWLEDGE_DIR"/}"
    [[ -e $target ]] && continue
    mkdir -p "${target%/*}"
    cp "$file" "$target"
  done < <(find "$KNOWLEDGE_DIR" -type f ! -name '.*' -print0)
}

# Only files from content/sources.txt and content/knowledge get embeddings.
# By default NOMAD indexes every downloaded ZIM, which takes days on a CPU.
manual_ingest() {
  api PATCH /system/settings --data '{"key": "rag.defaultIngestPolicy", "value": "Manual"}' >/dev/null
}

# Remote embeddings (NOMAD_EMBED_URL): no bundled Ollama, which saves ~3 GB of disk and the RAM
setup_remote_embeddings() {
  api POST /ollama/configure-remote --data "$(json --arg u "$LLM_ROUTER_URL" '{remoteUrl: $u}')" >/dev/null \
    || fail "Could not connect NOMAD to ${NOMAD_LLM_URL}. Is the LLM server running?"
  curl -fs -m 5 "${EMBED_OLLAMA}/api/tags" | jq -e --arg m "$EMBED_MODEL" '.models[] | select(.name == $m)' >/dev/null \
    || log "No ${EMBED_MODEL} at ${NOMAD_EMBED_URL}; run there: ollama pull ${EMBED_MODEL}"
}

# The bundled Ollama only computes embeddings; chat goes through nomad-llm to NOMAD_LLM_URL
setup_ai() {
  if [[ -n ${NOMAD_EMBED_URL:-} ]]; then
    setup_remote_embeddings
    return
  fi
  add_service nomad_ollama
  api PATCH /system/settings --data "$(json --arg u "$LLM_ROUTER_URL" '{key: "ai.remoteOllamaUrl", value: $u}')" >/dev/null
  curl -fs -m 5 "$(llm_upstream)/v1/models" >/dev/null \
    || log "No LLM server at ${NOMAD_LLM_URL} yet; chat works as soon as it is running"
  docker exec nomad_ollama ollama show "$EMBED_MODEL" >/dev/null 2>&1 && return
  log "Downloading ${EMBED_MODEL}"
  docker exec nomad_ollama ollama pull "$EMBED_MODEL" >/dev/null
  log "✓ ${EMBED_MODEL}"
}

rag_state() {
  api GET /rag/files | jq -r --arg s "$1" '[.files[] | select(.source == $s) | .state] | first // "new"'
}

# force drops chunks left by an interrupted run; 409 means the file is already queued
embed_request() {
  curl -sS -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
    "${API_URL}/rag/files/embed" --data "$(json --arg s "$1" '{source: $s, force: true}')"
}

planned_zim() {
  local file
  for file in "${ZIM_DIR}/${1}" "${ZIM_DIR}/${1}"_[0-9][0-9][0-9][0-9]-[0-9][0-9].zim; do
    [[ $file == *.zim && -f $file ]] && { printf '%s\n' "${ADMIN_ZIM_DIR}/${file##*/}"; return; }
  done
  return 1
}

# Files to index as nomad_admin paths; a ZIM that is still downloading as "?name"
planned_sources() {
  local item file
  for item in $(items embed); do
    planned_zim "$item" || printf '?%s\n' "$item"
  done
  [[ -d $KNOWLEDGE_DIR ]] || return 0
  find "$KNOWLEDGE_DIR" -type f ! -name '.*' | while IFS= read -r file; do
    printf '%s\n' "${ADMIN_KB_DIR}/${file#"$KNOWLEDGE_DIR"/}"
  done
}

# Runs in the background until every planned file is indexed. A job cut off by a NOMAD
# restart fails after 30 min without changing the file state; the file is then indexed again.
embed_planned() {
  local source state code pending
  local -A tries=() noted=()
  while :; do
    pending=0
    while IFS= read -r source; do
      if [[ $source == \?* ]]; then
        [[ -n ${noted[$source]:-} ]] || log "${source#\?} will be indexed once downloaded"
        noted[$source]=1
        pending=1
        continue
      fi
      state=$(rag_state "$source") || { pending=1; continue; }
      [[ $state == indexed || $state == browse_only ]] && continue
      if ((${tries[$source]:-0} >= 3)); then
        [[ -n ${noted[$source]:-} ]] || log "✗ Indexing ${source##*/} failed 3 times; details: make logs-admin"
        noted[$source]=1
        continue
      fi
      pending=1
      code=$(embed_request "$source") || code=000
      case $code in
        202)
          tries[$source]=$((${tries[$source]:-0} + 1))
          log "Indexing for AI in the background: ${source##*/}"
          ;;
        409) ;;
        *)
          tries[$source]=3
          log "✗ Could not queue indexing of ${source##*/} (HTTP ${code})"
          ;;
      esac
    done < <(planned_sources)
    ((pending)) || return 0
    sleep 60
  done
}

main() {
  wait_for 600 api GET /health || fail "Command Center is not running. Run: make up"
  [[ -f $SOURCES ]] || fail "${SOURCES} is missing"
  manual_ingest || log "✗ Could not turn off automatic indexing; NOMAD will index every ZIM file"
  local kind item
  for kind in service zim category map; do
    for item in $(items "$kind"); do
      ("add_${kind}" "$item") || log "✗ Skipped ${kind} ${item}"
    done
  done
  (setup_ai) || log "✗ Could not set up the AI assistant"
  [[ -d $KNOWLEDGE_DIR ]] && { (sync_knowledge) || log "✗ Could not sync the knowledge base"; }
  api POST /zim/rescan-library >/dev/null 2>&1 || true
  (
    flock -n 9 || exit 0
    embed_planned
  ) 9>"$EMBED_LOCK" >/proc/1/fd/1 2>&1 &
  log "Content from content/sources.txt is installed or downloading in the background: ${NOMAD_URL}"
}

main "$@"
