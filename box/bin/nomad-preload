#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/nomad-box/common.sh
source "$SECRETS_FILE"

readonly SOURCES=/opt/nomad-box/content/sources.txt
readonly KNOWLEDGE_DIR=/opt/nomad-box/content/knowledge
readonly ZIM_DIR="${NOMAD_HOME}/storage/zim"
readonly MAPS_DIR="${NOMAD_HOME}/storage/maps"
readonly KB_DIR="${NOMAD_HOME}/storage/kb_uploads"
# Te same katalogi widziane z kontenera nomad_admin (ścieżki źródeł w bazie wiedzy AI)
readonly ADMIN_ZIM_DIR=/app/storage/zim
readonly ADMIN_KB_DIR=/app/storage/kb_uploads
readonly EMBED_LOCK=/run/nomad-embed.lock

items() {
  awk -v kind="$1" '$1 == kind { print $2 }' "$SOURCES"
}

exists() {
  compgen -G "$1" >/dev/null
}

service_status() {
  db_query "SELECT CONCAT(installed, ':', installation_status) FROM services WHERE service_name = '$1'"
}

await_service() {
  local name=$1 status
  local deadline=$((SECONDS + 1800))
  while ((SECONDS < deadline)); do
    status=$(service_status "$name" 2>/dev/null) || status=unknown
    [[ $status == 1:* ]] && return
    [[ $status == *:error ]] && fail "Instalacja ${name} nie powiodła się. Szczegóły: make logs-admin"
    sleep 5
  done
  fail "Usługa ${name} nie zainstalowała się w 30 min. Szczegóły: make logs-admin"
}

add_service() {
  local name=$1 status
  status=$(service_status "$name")
  [[ -n $status ]] || fail "Nieznana usługa ${name}"
  [[ $status == 1:* ]] && return
  log "Instalacja usługi ${name}"
  [[ $status == *:installing ]] || api POST /system/services/install --data "$(json --arg n "$name" '{service_name: $n}')" >/dev/null \
    || fail "Nie udało się rozpocząć instalacji ${name}"
  await_service "$name"
  log "✓ ${name}"
}

add_zim() {
  local url=$1 name=${1##*/}
  if [[ $url == *.zim ]]; then
    exists "${ZIM_DIR}/${name}*" && return
  else
    exists "${ZIM_DIR}/${name}_[0-9][0-9][0-9][0-9]-[0-9][0-9].zim*" && return
    name=$(curl -fsSL "${url%/*}/" | grep -oE "${name}_[0-9]{4}-[0-9]{2}\.zim" | sort | tail -n1)
    [[ -n $name ]] || fail "Nie znaleziono pliku ZIM dla ${url}"
    url="${url%/*}/${name}"
  fi
  log "Pobieranie ZIM w tle: ${name}"
  api POST /zim/download-remote --data "$(json --arg u "$url" '{url: $u}')" >/dev/null
}

add_map() {
  local code=${1^^}
  exists "${MAPS_DIR}/pmtiles/${code,,}_*.pmtiles*" && return
  [[ -d ${MAPS_DIR}/basemaps-assets ]] || api POST /maps/download-base-assets --data '{}' >/dev/null
  log "Pobieranie mapy w tle: ${code}"
  api POST /maps/extract --data "$(json --arg c "$code" '{countries: [$c]}')" >/dev/null
}

add_category() {
  local count
  count=$(api POST /zim/download-category-tier \
    --data "$(json --arg c "${1%-*}" --arg t "$1" '{categorySlug: $c, tierSlug: $t}')" | jq '.resources | length') \
    || fail "Nie udało się pobrać kolekcji ${1}"
  [[ $count == 0 ]] || log "Pobieranie w tle: kolekcja ${1} (${count} plików)"
}

sync_knowledge() {
  local file target
  while IFS= read -r -d '' file; do
    target="${KB_DIR}/${file#"$KNOWLEDGE_DIR"/}"
    [[ -e $target ]] && continue
    mkdir -p "${target%/*}"
    cp "$file" "$target"
  done < <(find "$KNOWLEDGE_DIR" -type f ! -name '.*' -print0)
}

# Embeddingi liczą się tylko dla plików z content/sources.txt i content/knowledge.
# Domyślnie NOMAD indeksuje każdy pobrany ZIM, co na CPU trwa dniami.
manual_ingest() {
  api PATCH /system/settings --data '{"key": "rag.defaultIngestPolicy", "value": "Manual"}' >/dev/null
}

# Wbudowana Ollama liczy tylko embeddingi; czat idzie przez nomad-llm do NOMAD_OLLAMA_URL
setup_ai() {
  add_service nomad_ollama
  api PATCH /system/settings --data "$(json --arg u "$LLM_ROUTER_URL" '{key: "ai.remoteOllamaUrl", value: $u}')" >/dev/null
  docker exec nomad_ollama ollama show "$EMBED_MODEL" >/dev/null 2>&1 && return
  log "Pobieranie modelu ${EMBED_MODEL}"
  docker exec nomad_ollama ollama pull "$EMBED_MODEL" >/dev/null
  log "✓ ${EMBED_MODEL}"
}

rag_state() {
  api GET /rag/files | jq -r --arg s "$1" '[.files[] | select(.source == $s) | .state] | first // "new"'
}

# force usuwa fragmenty z przerwanego wcześniej indeksowania; 409 znaczy, że plik jest już w kolejce
embed_request() {
  curl -sS -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
    "${API_URL}/rag/files/embed" --data "$(json --arg s "$1" '{source: $s, force: true}')"
}

planned_zim() {
  local file
  for file in "${ZIM_DIR}/${1}" "${ZIM_DIR}/${1}"_[0-9][0-9][0-9][0-9]-[0-9][0-9].zim; do
    [[ $file == *.zim && -f $file ]] && { printf '%s\n' "${ADMIN_ZIM_DIR}/${file##*/}"; return; }
  done
  return 1
}

# Pliki do zindeksowania jako ścieżki w nomad_admin; ZIM, który jeszcze się pobiera, jako "?nazwa"
planned_sources() {
  local item file
  for item in $(items embed); do
    planned_zim "$item" || printf '?%s\n' "$item"
  done
  [[ -d $KNOWLEDGE_DIR ]] || return 0
  find "$KNOWLEDGE_DIR" -type f ! -name '.*' | while IFS= read -r file; do
    printf '%s\n' "${ADMIN_KB_DIR}/${file#"$KNOWLEDGE_DIR"/}"
  done
}

# Działa w tle, dopóki wszystkie zaplanowane pliki nie są zindeksowane. Zadanie przerwane
# restartem NOMAD po 30 min kończy się błędem bez zmiany stanu pliku; wtedy indeksujemy go od nowa.
embed_planned() {
  local source state code pending
  local -A tries=() noted=()
  while :; do
    pending=0
    while IFS= read -r source; do
      if [[ $source == \?* ]]; then
        [[ -n ${noted[$source]:-} ]] || log "Plik ${source#\?} zostanie zindeksowany po pobraniu"
        noted[$source]=1
        pending=1
        continue
      fi
      state=$(rag_state "$source") || { pending=1; continue; }
      [[ $state == indexed || $state == browse_only ]] && continue
      if ((${tries[$source]:-0} >= 3)); then
        [[ -n ${noted[$source]:-} ]] || log "✗ Indeksowanie ${source##*/} nie powiodło się 3 razy; szczegóły: make logs-admin"
        noted[$source]=1
        continue
      fi
      pending=1
      code=$(embed_request "$source") || code=000
      case $code in
        202)
          tries[$source]=$((${tries[$source]:-0} + 1))
          log "Indeksowanie dla AI w tle: ${source##*/}"
          ;;
        409) ;;
        *)
          tries[$source]=3
          log "✗ Nie udało się zlecić indeksowania ${source##*/} (HTTP ${code})"
          ;;
      esac
    done < <(planned_sources)
    ((pending)) || return 0
    sleep 60
  done
}

main() {
  wait_for 600 api GET /health || fail "Command Center nie działa. Uruchom najpierw: make up"
  [[ -f $SOURCES ]] || fail "Brak ${SOURCES}"
  manual_ingest || log "✗ Nie udało się wyłączyć automatycznego indeksowania; NOMAD zindeksuje wszystkie pliki ZIM"
  local kind item
  for kind in service zim category map; do
    for item in $(items "$kind"); do
      ("add_${kind}" "$item") || log "✗ Pominięto ${kind} ${item}"
    done
  done
  (setup_ai) || log "✗ Nie udało się przygotować asystenta AI"
  [[ -d $KNOWLEDGE_DIR ]] && { (sync_knowledge) || log "✗ Nie udało się zsynchronizować bazy wiedzy"; }
  api POST /zim/rescan-library >/dev/null 2>&1 || true
  (
    flock -n 9 || exit 0
    embed_planned
  ) 9>"$EMBED_LOCK" >/proc/1/fd/1 2>&1 &
  log "Treści z content/sources.txt są zainstalowane lub pobierają się w tle: ${NOMAD_URL}"
}

main "$@"
