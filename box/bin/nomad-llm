#!/usr/bin/env bash
set -Eeuo pipefail

source /usr/local/lib/nomad-box/common.sh

readonly TAGS_PORT=$((LLM_ROUTER_PORT + 1))
readonly CONFIG=/run/nomad-llm.caddyfile

# NOMAD_OLLAMA_URL as seen from the container: localhost is the machine running Docker
chat_upstream() {
  sed -E 's#://(localhost|127\.0\.0\.1)([:/]|$)#://host.docker.internal\2#; s#/$##' <<<"$NOMAD_OLLAMA_URL"
}

write_config() {
  cat >"$CONFIG" <<EOF
{
	admin off
	auto_https off
	persist_config off
	log {
		level ERROR
	}
}

:${LLM_ROUTER_PORT} {
	handle /api/tags {
		reverse_proxy 127.0.0.1:${TAGS_PORT}
	}
	@embed path /api/embed /api/embeddings /v1/embeddings
	handle @embed {
		reverse_proxy ${EMBED_OLLAMA}
	}
	handle {
		reverse_proxy $(chat_upstream) {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}
}
EOF
}

# Chat models from NOMAD_OLLAMA_URL plus embedding models from the bundled Ollama
tags() {
  local line body
  while IFS= read -r line && [[ -n ${line%$'\r'} ]]; do :; done
  body=$(jq -cs '{models: ((.[0].models // []) + (.[1].models // [] | map(select(.name | contains("embed")))))}' \
    <(curl -fs -m 3 "$(chat_upstream)/api/tags" || echo '{}') \
    <(curl -fs -m 3 "${EMBED_OLLAMA}/api/tags" || echo '{}'))
  printf 'HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
    "$(printf '%s' "$body" | wc -c)" "$body"
}

serve() {
  write_config
  log "Chat LLM: ${NOMAD_OLLAMA_URL}; embeddings: bundled Ollama (${EMBED_MODEL})"
  socat "TCP-LISTEN:${TAGS_PORT},bind=127.0.0.1,fork,reuseaddr" EXEC:"nomad-llm tags" &
  exec caddy run --adapter caddyfile --config "$CONFIG"
}

case ${1:-} in
  serve) serve ;;
  tags) tags ;;
  *) fail "Usage: nomad-llm serve|tags" ;;
esac
