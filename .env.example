# HTTPS pod https://nomad.localhost. Bez HTTPS (tylko http://localhost:8080) usuń obie linie.
COMPOSE_PROFILES=https
NOMAD_DOMAIN=nomad.localhost

# Opcjonalne (pokazane wartości domyślne)
# Ollama z modelem do czatu; localhost to komputer z Dockerem. Na Linuksie uruchom ją z OLLAMA_HOST=0.0.0.0.
# NOMAD_OLLAMA_URL=http://localhost:11434
# NOMAD_BOX_IMAGE=nomad-box:latest
# NOMAD_PORT=8080
# NOMAD_HTTPS_PORT=443
# NOMAD_DATA_DIR=./data
# NOMAD_URL=https://nomad.localhost
# NOMAD_INTERNET_TEST_URL=https://1.1.1.1/cdn-cgi/trace
