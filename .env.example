# HTTPS at https://nomad.localhost. Remove both lines for plain http://localhost:8080.
COMPOSE_PROFILES=https
NOMAD_DOMAIN=nomad.localhost

# Optional (defaults shown)
# LLM server for AI chat (Ollama, LM Studio, llama.cpp, ...); localhost is the machine running Docker
# NOMAD_LLM_URL=http://localhost:11434
# Server for embeddings (nomic-embed-text:v1.5) instead of the bundled Ollama, e.g. the same as NOMAD_LLM_URL
# NOMAD_EMBED_URL=
# NOMAD_BOX_IMAGE=nomad-box:latest
# NOMAD_PORT=8080
# NOMAD_HTTPS_PORT=443
# NOMAD_DATA_DIR=./data
# NOMAD_URL=https://nomad.localhost
# NOMAD_INTERNET_TEST_URL=https://1.1.1.1/cdn-cgi/trace
