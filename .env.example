# HTTPS at https://nomad.localhost. Remove both lines for plain http://localhost:8080.
COMPOSE_PROFILES=https
NOMAD_DOMAIN=nomad.localhost

# Optional (defaults shown)
# Ollama with the chat model; localhost is the machine running Docker. On Linux start it with OLLAMA_HOST=0.0.0.0.
# NOMAD_OLLAMA_URL=http://localhost:11434
# NOMAD_BOX_IMAGE=nomad-box:latest
# NOMAD_PORT=8080
# NOMAD_HTTPS_PORT=443
# NOMAD_DATA_DIR=./data
# NOMAD_URL=https://nomad.localhost
# NOMAD_INTERNET_TEST_URL=https://1.1.1.1/cdn-cgi/trace
